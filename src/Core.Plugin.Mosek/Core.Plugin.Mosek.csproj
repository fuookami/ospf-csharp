<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Fuookami.Ospf.Core.Plugin.Mosek</RootNamespace>
    <AssemblyName>Fuookami.Ospf.Core.Plugin.Mosek</AssemblyName>
    <MosekManagedAssembly Condition="'$(MosekManagedAssembly)' == ''">$(MOSEK_10_2_INSTALLDIR)/tools/platform/win64x86/bin/mosekdotnet10_2.dll</MosekManagedAssembly>
    <MosekAvailable Condition="Exists('$(MosekManagedAssembly)')">true</MosekAvailable>
    <DefineConstants Condition="'$(MosekAvailable)' == 'true'">$(DefineConstants);MOSEK_AVAILABLE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Fuookami.Ospf.Core.Plugin.Mosek.Tests" />
  </ItemGroup>
  <!-- Native runtime: mosek64_10_2.dll on PATH or next to the managed DLL. -->
  <ItemGroup Condition="'$(MosekAvailable)' == 'true'">
    <Compile Remove="MosekUnavailable.cs" />
    <Reference Include="mosekdotnet10_2">
      <HintPath>$(MosekManagedAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(MosekAvailable)' != 'true'">
    <Compile Remove="MosekLinearSolver.cs;MosekSolver.cs;MosekSolverCallBack.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Utils\Utils.csproj" />
    <ProjectReference Include="..\Math\Math.csproj" />
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Framework\Framework.csproj" />
  </ItemGroup>
</Project>
