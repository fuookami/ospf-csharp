<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Fuookami.Ospf.Core.Plugin.Gurobi</RootNamespace>
    <AssemblyName>Fuookami.Ospf.Core.Plugin.Gurobi</AssemblyName>
    <Gurobi110ManagedAssembly>$(GUROBI_HOME)/lib/gurobi110.netstandard20.dll</Gurobi110ManagedAssembly>
    <Gurobi100ManagedAssembly>$(GUROBI_HOME)/lib/gurobi100.netstandard20.dll</Gurobi100ManagedAssembly>
    <GurobiManagedAssembly Condition="Exists('$(Gurobi110ManagedAssembly)')">$(Gurobi110ManagedAssembly)</GurobiManagedAssembly>
    <GurobiManagedAssembly Condition="'$(GurobiManagedAssembly)' == '' and Exists('$(Gurobi100ManagedAssembly)')">$(Gurobi100ManagedAssembly)</GurobiManagedAssembly>
    <GurobiAvailable Condition="Exists('$(GurobiManagedAssembly)')">true</GurobiAvailable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Fuookami.Ospf.Core.Plugin.Gurobi11" />
    <InternalsVisibleTo Include="Fuookami.Ospf.Core.Plugin.Gurobi.Tests" />
  </ItemGroup>
  <!-- Prefer Gurobi 11, then fall back to the ABI-matched Gurobi 10.0.1 installation. -->
  <ItemGroup Condition="'$(GurobiAvailable)' == 'true'">
    <Compile Remove="GurobiUnavailable.cs" />
    <Reference Include="Gurobi">
      <HintPath>$(GurobiManagedAssembly)</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(GurobiAvailable)' != 'true'">
    <Compile Remove="GurobiBendersDecompositionSolver.cs;GurobiColumnGenerationSolver.cs;GurobiConstraint.cs;GurobiLinearSolver.cs;GurobiQuadraticSolver.cs;GurobiSolveCallback.cs;GurobiSolver.cs;GurobiSolverCallBack.cs;GurobiVariable.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Utils\Utils.csproj" />
    <ProjectReference Include="..\Math\Math.csproj" />
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Framework\Framework.csproj" />
  </ItemGroup>
</Project>
