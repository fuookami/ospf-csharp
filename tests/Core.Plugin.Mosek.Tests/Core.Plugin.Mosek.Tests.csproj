<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Fuookami.Ospf.Core.Plugin.Mosek.Tests</RootNamespace>
    <AssemblyName>Fuookami.Ospf.Core.Plugin.Mosek.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <MosekManagedAssembly Condition="'$(MosekManagedAssembly)' == ''">$(MOSEK_10_2_INSTALLDIR)/tools/platform/win64x86/bin/mosekdotnet10_2.dll</MosekManagedAssembly>
    <MosekAvailable Condition="Exists('$(MosekManagedAssembly)')">true</MosekAvailable>
    <DefineConstants Condition="'$(MosekAvailable)' == 'true'">$(DefineConstants);MOSEK_AVAILABLE</DefineConstants>
    <MosekIntegration Condition="'$(RunMosekIntegration)' == 'true'">true</MosekIntegration>
    <DefineConstants Condition="'$(MosekIntegration)' == 'true'">$(DefineConstants);MOSEK_INTEGRATION</DefineConstants>
  </PropertyGroup>
  <Target Name="RequireMosekForIntegration" BeforeTargets="PrepareForBuild" Condition="'$(MosekIntegration)' == 'true' and '$(MosekAvailable)' != 'true'">
    <Error Text="MOSEK integration tests require MOSEK_10_2_INSTALLDIR or MosekManagedAssembly." />
  </Target>
  <ItemGroup Condition="'$(MosekAvailable)' == 'true'">
    <Reference Include="mosekdotnet10_2">
      <HintPath>$(MosekManagedAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(MosekAvailable)' != 'true'">
    <Compile Remove="MosekLinearSolverSmokeTest.cs;MosekIntegrationTest.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xUnit" />
    <PackageReference Include="xUnit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Core.Plugin.Mosek\Core.Plugin.Mosek.csproj" />
  </ItemGroup>
</Project>
