<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Fuookami.Ospf.Core.Plugin.Copt.Tests</RootNamespace>
    <AssemblyName>Fuookami.Ospf.Core.Plugin.Copt.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CoptManagedAssembly>$(COPT_HOME)/bin/copt_dotnet20.dll</CoptManagedAssembly>
    <CoptAvailable Condition="Exists('$(CoptManagedAssembly)')">true</CoptAvailable>
    <DefineConstants Condition="'$(CoptAvailable)' == 'true'">$(DefineConstants);COPT_AVAILABLE</DefineConstants>
    <DefineConstants Condition="'$(RunCoptIntegration)' == 'true' and '$(CoptAvailable)' == 'true'">$(DefineConstants);COPT_INTEGRATION</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateCoptIntegrationSdk" BeforeTargets="CoreCompile" Condition="'$(RunCoptIntegration)' == 'true' and '$(CoptAvailable)' != 'true'">
    <Error Text="COPT integration requires the COPT 8 managed SDK. / COPT 集成测试需要 COPT 8 托管 SDK。" />
  </Target>
  <ItemGroup Condition="Exists('$(CoptManagedAssembly)')">
    <Reference Include="copt_dotnet20">
      <HintPath>$(CoptManagedAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xUnit" />
    <PackageReference Include="xUnit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Core.Plugin.Copt\Core.Plugin.Copt.csproj" />
    <Compile Include="..\Shared\RelaxationOwnershipTest.cs" Link="RelaxationOwnershipTest.cs" />
  </ItemGroup>
</Project>
