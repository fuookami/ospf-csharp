<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Fuookami.Ospf.Core.Plugin.Hexaly.Tests</RootNamespace>
    <AssemblyName>Fuookami.Ospf.Core.Plugin.Hexaly.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <HexalyManagedAssembly>$(HEXALY_HOME)/bin/Hexaly.NET.dll</HexalyManagedAssembly>
    <HexalyAvailable Condition="Exists('$(HexalyManagedAssembly)')">true</HexalyAvailable>
    <DefineConstants Condition="'$(HexalyAvailable)' == 'true'">$(DefineConstants);HEXALY_AVAILABLE</DefineConstants>
    <DefineConstants Condition="'$(RunHexalyIntegration)' == 'true' and '$(HexalyAvailable)' == 'true'">$(DefineConstants);HEXALY_INTEGRATION</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateHexalyIntegrationSdk" BeforeTargets="CoreCompile" Condition="'$(RunHexalyIntegration)' == 'true' and '$(HexalyAvailable)' != 'true'">
    <Error Text="Hexaly integration requires HEXALY_HOME/bin/Hexaly.NET.dll. / Hexaly 集成测试需要 HEXALY_HOME/bin/Hexaly.NET.dll。" />
  </Target>
  <ItemGroup Condition="'$(HexalyAvailable)' == 'true'">
    <Reference Include="Hexaly.NET">
      <HintPath>$(HexalyManagedAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(HexalyAvailable)' != 'true'">
    <Compile Remove="HexalyContractTest.cs;HexalyIntegrationTest.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xUnit" />
    <PackageReference Include="xUnit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Core.Plugin.Hexaly\Core.Plugin.Hexaly.csproj" />
  </ItemGroup>
</Project>
